{
  "manifest_version": 3,
  "name": "本地二维码识别",
  "version": "1.3.0",
  "description": "右键网页图片识别二维码。纯链接可一键打开，文字夹链接时渲染超链接，纯文字可一键复制。全程本地计算，不联网、不上传。",
  "minimum_chrome_version": "96",
  "permissions": ["contextMenus", "activeTab", "scripting", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "本地二维码识别：右键图片使用",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  }
}
